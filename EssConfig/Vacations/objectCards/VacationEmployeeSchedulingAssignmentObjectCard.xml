<?xml version="1.0" encoding="utf-8"?>
<objectCard id="a35bbaea-dccb-4fb9-92a7-ac465b5e27a3" name="IVacationEmployeeSchedulingAssignments" header="@.OBJECTCARD_VACATIONSCHEDULINGOBJECTCARD_HEADER" icon="task">
  <views>
    <view deviceIdioms="All" deviceOrientations="Landscape, Portrait">
      <fields>
        <field caption="@ESSBASE.DEFAULTCARD_TITLE_CAPTION" binding="title" />
        <field caption="@ESSBASE.DEFAULTCARD_DEADLINE_CAPTION" converter="EssBase.getDeadline" />
        <field caption="@HRPROVACATIONS.OBJECTCARD_DEFAULT_RESULT_CAPTION" binding="result" />
        <field caption="@ESSBASE.DEFAULTCARD_PERFORMER_CAPTION" binding="PerformerInfo" type="Employee" />
      </fields>
      <content></content>
    </view>
  </views>
  <buttons>
    <button name="Complete" isPrimary="true" isDefault="true">
      <icon />
      <caption>@.OBJECTCARD_VACATIONSCHEDULINGOBJECTCARD_BUTTON_SCHEDULE</caption>
      <clickEventHandler><![CDATA[
        var yearRequisite = data.requisites.find(function (_ref) {
          var name = _ref.name;
          return name === 'Year';
        });
        ESS.actions.facilityActions.runFacility({id:'ScheduleVacation'}, {parameters:{AssignmentId: data.id, Year: yearRequisite.value, AssignmentType: data.name}}, sender);
      ]]></clickEventHandler>
    </button>
  </buttons>
  <include xmlns="http://www.w3.org/2001/XInclude" href="CardBadge/FormOpeningForGetPerformerVacations.xml" />
  <openedEventHandler><![CDATA[resolve({configuration: configuration, data: data});]]></openedEventHandler>
  <closedEventHandler><![CDATA[
    if(data.isRead === false)
    {
      ESS.widgets.updateWidgets();
    }
  ]]></closedEventHandler>
</objectCard>