  <facilityFormItems>
    <facilityFormItem type="FacilityFormParameter" name="PerformerInfo">
      <hint></hint>
      <isReadOnly>true</isReadOnly>
      <isHidden>false</isHidden>
      <showHeaders>true</showHeaders>
      <label>@.FACILITIES_SHIFTANNUALVACATIONFROMCONFIRMATIONASSIGNMENT_PERFORMERINFO</label>
      <placeholder />
      <parameterName>PerformerInfo</parameterName>
      <calculateFunction><![CDATA[]]></calculateFunction>
      <valueChangedEventHandler><![CDATA[]]></valueChangedEventHandler>
    </facilityFormItem>
    <facilityFormItem type="FacilityFormTextblock">
      <hint />
      <content><![CDATA[
      <div style="font-size: 16px;line-height: 20px;font-weight: 700;margin-bottom: 12px;">Доступно дней для компенсации: {{{AvailableDays}}}</div>
        {{#AvailableDays}}
             Из них:<br/>
             {{{AvailableDaysInfo}}}
        {{/AvailableDays}}
        {{#Info}}
          <br/><br/>{{{Info}}}
        {{/Info}}
      ]]></content>
    </facilityFormItem>
    <facilityFormItem type="FacilityFormParameter">
      <hint />
      <isReadOnly>false</isReadOnly>
      <isHidden>false</isHidden>
      <showHeaders>false</showHeaders>
      <label>@.FACILITIES_COMPENSATIONVACATION_DOCUMENTKIND</label>
      <placeholder />
      <parameterName>DocumentKind</parameterName>
      <calculateFunction><![CDATA[]]></calculateFunction>
      <valueChangedEventHandler><![CDATA[
        if (formItem.value)
        {
          var kindId = functions.getValues().CompensationAdditionalVacationKind;
          if (formItem.value == kindId) {
            functions.setValue('Info', ESS.L('@HRPROVACATIONS.FACILITIES_COMPENSATIONVACATION_DOCUMENTKIND_WARNING'));
          }
          else {
            functions.setValue('Info', '');
          }
        }
      ]]></valueChangedEventHandler>
    </facilityFormItem>
    <facilityFormItem type="FacilityFormParameter" name="DaysSelected">
      <hint />
      <isReadOnly>false</isReadOnly>
      <isHidden>false</isHidden>
      <showHeaders>false</showHeaders>
      <label>@.FACILITIES_COMPENSATIONVACATION_DAYSSELECTED</label>
      <placeholder />
      <parameterName>DaysSelected</parameterName>
      <calculateFunction><![CDATA[]]></calculateFunction>
      <valueChangedEventHandler><![CDATA[
        var errorId = functions.getValues().ErrorId;
        if (errorId)
          functions.removeError(errorId);
          
        var daysSelected = formItem.value;
        if (daysSelected)
        {
          var availableDays = functions.getValues().AvailableDays;
          if (availableDays < daysSelected)
          {
            var errorType = ESS.enums.FormErrorType.FORM_VALIDATION;
            errorId = functions.showError(ESS.L('@HRPROVACATIONS.FACILITIES_COMPENSATIONVACATION_DAYSSELECTED_ERROR'), undefined, errorType, 'DaysSelected');
            functions.setValue('ErrorId', errorId);
          };
        }
        functions.setValue('Field_Количество дней', formItem.value)
      ]]></valueChangedEventHandler>
    </facilityFormItem>
  </facilityFormItems>
  <facilityFlowScheme firstStepIndex="0" lastStepIndex="-1">
    <flowSteps>
      <flowStep index="0" name="ExecuteFunction" title="Получить должность и ФИО Вице-президента." type="ExecuteFunctionStep">
        <property name="NextStepIndex">1</property>
        <property name="TargetSystem">HRPro</property>
        <property name="FunctionName">NNVacations.GetDocumentFieldValue</property>
        <property name="ExecutionMethod">GET</property>
        <property name="employeeId" binding="InitiatorId" type="Int" />
        <property name="fieldName">VICE_PRESIDENT</property>
        <property name="Result" binding="Field_Вице_Президент,Mode=PropertyToParameter" />
      </flowStep>
      <flowStep index="1" name="ExecuteFunction" title="Получить наименование должности сотрудника." type="ExecuteFunctionStep">
        <property name="NextStepIndex">2</property>
        <property name="TargetSystem">HRPro</property>
        <property name="FunctionName">NNVacations.GetDocumentFieldValue</property>
        <property name="ExecutionMethod">GET</property>
        <property name="employeeId" binding="InitiatorId" type="Int" />
        <property name="fieldName">CURRENT_USER_JOB_TITLE_NOMINATIVE</property>
        <property name="Result" binding="Field_Должность сотрудника,Mode=PropertyToParameter" />
      </flowStep>
      <flowStep index="2" name="ExecuteFunction" title="Получить наименование структурного подразделения сотрудника." type="ExecuteFunctionStep">
        <property name="NextStepIndex">3</property>
        <property name="TargetSystem">HRPro</property>
        <property name="FunctionName">NNVacations.GetDocumentFieldValue</property>
        <property name="ExecutionMethod">GET</property>
        <property name="employeeId" binding="InitiatorId" type="Int" />
        <property name="fieldName">DEPARTMENT_NAME</property>
        <property name="Result" binding="Field_Структурное подразделение,Mode=PropertyToParameter" />
      </flowStep>
      <flowStep index="3" name="ExecuteFunction" title="Получить ФИО сотрудника." type="ExecuteFunctionStep">
        <property name="NextStepIndex">4</property>
        <property name="TargetSystem">HRPro</property>
        <property name="FunctionName">NNVacations.GetDocumentFieldValue</property>
        <property name="ExecutionMethod">GET</property>
        <property name="employeeId" binding="InitiatorId" type="Int" />
        <property name="fieldName">CURRENT_USER_FULLNAME</property>
        <property name="Result" binding="Field_ФИО сотрудника,Mode=PropertyToParameter" />
      </flowStep>
      <flowStep index="4" name="ExecuteFunction" title="Получить табельный номер сотрудника." type="ExecuteFunctionStep">
        <property name="NextStepIndex">5</property>
        <property name="TargetSystem">HRPro</property>
        <property name="FunctionName">NNVacations.GetDocumentFieldValue</property>
        <property name="ExecutionMethod">GET</property>
        <property name="employeeId" binding="InitiatorId" type="Int" />
        <property name="fieldName">CURRENT_USER_PERSONNEL_NUMBER</property>
        <property name="Result" binding="Field_Табельный_номер,Mode=PropertyToParameter" />
      </flowStep>
      <flowStep index="5" name="ExecuteFunction" title="Получить инициалы и фамилию сотрудника." type="ExecuteFunctionStep">
        <property name="NextStepIndex">6</property>
        <property name="TargetSystem">HRPro</property>
        <property name="FunctionName">NNVacations.GetDocumentFieldValue</property>
        <property name="ExecutionMethod">GET</property>
        <property name="employeeId" binding="InitiatorId" type="Int" />
        <property name="fieldName">CURRENT_USER_SHORTNAME</property>
        <property name="Result" binding="Field_И.О. Фамилия сотрудника,Mode=PropertyToParameter" />
      </flowStep>
      <flowStep index="6" name="ExecuteFunction" title="Получить фамилию и инициалы сотрудника в родительном падеже." type="ExecuteFunctionStep">
        <property name="NextStepIndex">7</property>
        <property name="TargetSystem">HRPro</property>
        <property name="FunctionName">NNVacations.GetDocumentFieldValue</property>
        <property name="ExecutionMethod">GET</property>
        <property name="employeeId" binding="InitiatorId" type="Int" />
        <property name="fieldName">CURRENT_USER_SHORTNAME_GENITIVE</property>
        <property name="Result" binding="Field_Фамилия И.О. сотрудника (р.п.),Mode=PropertyToParameter" />
      </flowStep>
      <flowStep index="7" name="ApplicationGeneration" title="Сгенерировать заявление" type="DocumentGenerationStep">
        <property name="NextStepIndex">8</property>
        <property name="TargetSystem">HRPro</property>
        <property name="DocumentId" type="Int" binding="TemplateId" />
        <property name="DocumentFormat">pdfa</property>
        <property name="DocumentGroup">IElectronicDocuments</property>
        <property name="DocumentFields" binding="Field_*" type="KeyValue[]" />
        <property name="DocumentName" binding="Field_Фамилия И.О. сотрудника (р.п.),#TODAY,Format=Заявление на компенсацию части отпуска {0} от {1}" />
        <property name="GenerationValue" binding="StoredDocumentParam,Mode=PropertyToParameter" type="StoredDocument" />
      </flowStep>
      <actionStep index="8" name="CreateSignatureAction" title="Добавить подпись к документу из СХ">
        <property name="NextStepIndex">9</property>
        <property name="ActionName">HrProStatements.createSignature</property>
        <property name="SigningDocument" binding="StoredDocumentParam" type="StoredDocument" />
        <property name="SignatureType">Approval</property>
        <property name="Result" binding="StoredDocumentParam,Mode=PropertyToParameter" />
        <property name="employeeId" binding="InitiatorId" type="Int" />
      </actionStep>
      <flowStep index="9" name="ImportDocumentsRX" title="Импортировать сгенерированный документ в RX" type="ImportDocumentGroupStep">
        <property name="NextStepIndex">10</property>
        <property name="TargetSystem">HRPro</property>
        <property name="ImportingDocuments" binding="StoredDocument*" type="StoredDocument[]" />
        <property name="DocumentGroup">IVacationStatementDocuments</property>
        <property name="DocumentId" binding="StatementId" type="Int" />
        <property name="Author" binding="InitiatorId,Format={{'Id':{0}}}"/>
        <property name="Actor" binding="InitiatorId"/>
        <property name="ImportedDocuments" binding="ImportedDocumentLinks,Mode=PropertyToParameter" />
      </flowStep>
      <flowStep index="10" title="Заполнить данные в заявлении на компенсацию отпуска" type="ExecuteFunctionStep">
        <property name="TargetSystem">HRPro</property>
        <property name="NextStepIndex">11</property>
        <property name="ExecutionMethod">POST</property>
        <property name="document" binding="ImportedDocumentLinks" type="String" />
        <property name="documentKindId" binding="DocumentKind" type="Int" />
        <property name="daysSelected" binding="DaysSelected" type="Int" />
        <property name="availableDays" binding="AvailableDays" type="String" />
        <property name="FunctionName">NNVacations.FillStatementDataForCompensation</property>
      </flowStep>
      <flowStep index="11" name="CompleteReworkAssignment" title="Выполнить задание с результатом Исправлено" type="ChangeWorkItemStateStep">
        <property name="WorkItemName" binding="AssignmentType" />
        <property name="WorkItemId" binding="AssignmentId" />
        <property name="TargetSystem">HRPro</property>
        <property name="NextStepIndex">-1</property>
        <property name="State">Complete</property>
        <property name="StateChangeReason">ForReapproving</property>
      </flowStep>
    </flowSteps>
  </facilityFlowScheme>
  <openingEventHandler><![CDATA[
    var assignmentId = functions.getValues().AssignmentId;
    ESS.network.sendRequest(`/api/functions/GetPostListByPerson`)
    .then(function (employee){
      if (employee.positions.length == 1) {
        functions.setIsItemHidden('PerformerInfo', true);
      }
    });
    ESS.network.sendRequest(`/api/functions/GetStatementDataForReworkCompensation?assignmentId=${assignmentId}`)
    .then(function (statementData){
      var initiatorId = statementData.InitiatorId;
      functions.setValue('InitiatorId', initiatorId);
      functions.setValue('StatementId', statementData.StatementId);
      functions.setValue('DocumentKind', statementData.DocumentKind);
      functions.setValue('PerformerInfo', statementData.PerformerInfo);
      ESS.network.sendRequest(`/api/functions/GetCurrentCompensationAvailableDays?employeeId=${initiatorId}`)
      .then(function (AvailableDays) {
        if (AvailableDays.ErrorText == null || AvailableDays.ErrorText.length == 0) {
          functions.setValue('AvailableDaysInfo', AvailableDays.DayCountString);
          functions.setValue('AvailableDays', AvailableDays.DayCount);
          functions.setValue('DaysSelected', statementData.DaysSelected);
          ESS.network.sendRequest(`/api/functions/GetCompensationDocumentKinds`)
          .then(function (docKinds){
            if (docKinds && docKinds[1])
              functions.setValue('CompensationAdditionalVacationKind', docKinds[1].Id);
            resolve();
          });
        }
        else {
          ESS.dialogs.showMessageBox(ESS.L('@HRPROVACATIONS.ERROR_COMMON'), AvailableDays.ErrorText);
          reject();
        }
      });
    })
    .catch(function (error) {
      ESS.toasts.showToast(error.message, 'danger', false);
    });
  ]]></openingEventHandler>
  <openedEventHandler><![CDATA[]]></openedEventHandler>
  <beforeSubmitEventHandler><![CDATA[
    var initiatorId = functions.getValues().InitiatorId;
    var documentKind = functions.getValues().DocumentKind;
    var daysSelected = functions.getValues().DaysSelected;
    var getTemplateId = ESS.network.sendRequest(`/api/functions/GetCompensationVacationTemplateId?docKindId=${documentKind}&employeeId=${initiatorId}`)
    .then(function (VacationStatementData) {
      if (VacationStatementData.Error.length == 0) {
        functions.setValue('TemplateId', VacationStatementData.TemplateId);
      }
      else {
        ESS.dialogs.showMessageBox(ESS.L('@HRPROVACATIONS.ERROR_COMMON'), VacationStatementData.Error);
        reject();
      }
    })
    .catch(function (error) {
      ESS.toasts.showToast(error.message, 'danger', false);
      reject();
    });

    var validateVacationData = ESS.network.sendRequest(`/api/functions/ValidateVacationCompensation?employeeId=${initiatorId}&daysSelected=${daysSelected}`)
    .then(function (validateVacationResult) {
      if (validateVacationResult.ErrorText && validateVacationResult.ErrorText.length != 0) {
        ESS.toasts.showToast(validateVacationResult.ErrorText, 'danger', false);
        reject();
      }
      else {
        resolve();
      }
    })
    .catch(function (error) {
      ESS.toasts.showToast(error.message, 'danger', false);
      reject();
    });

    Promise.all([
      getTemplateId,
      validateVacationData
    ])
    .then((success) => { resolve() }, (error) => { reject() });
  ]]></beforeSubmitEventHandler>
  <closingEventHandler><![CDATA[]]></closingEventHandler>
  <closedEventHandler><![CDATA[
    if (sender.performingAction === 'SUBMIT_FACILITY_PARAMETERS') 
    {
      ESS.closeElement(sender.parent); 
      ESS.widgets.updateWidgets();
    }
  ]]></closedEventHandler>
  <contractForm>True</contractForm >
  <successMessage>@HRPROVACATIONS.FACILITIES_GETVACATION_SUCCESSMESSAGE</successMessage>
</facility>