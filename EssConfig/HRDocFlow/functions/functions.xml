        <defaultValue>$(CurrentUser.DirectumRX.ActorId)</defaultValue>
      </parameter>
    </parameters>
    <result type="Object" isArray="true" />
    <target system="HRPro" function="HRDocFlow.GetJSONForStatements" method="GET" />
