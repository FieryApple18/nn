    <parameters>
      <parameter name="query" type="String" scope="Client"/>
      <parameter name="takeCount" type="Integer" scope="Client"/>
      <parameter name="skipCount" type="Integer" scope="Client"/>
    </parameters>
    <result type="Object"/>
    <target system="HRPro" function="NNCommons.GetVisibleEmployees" method="GET"/>
  </function>
  
