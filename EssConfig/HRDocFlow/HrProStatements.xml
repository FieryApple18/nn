  <scripts>
    <script name="createSignature" runat="Client">
      <code><![CDATA[
        class createSignature {
          execute(params) {
            const document = JSON.parse(params.SigningDocument);
            const serviceUrl = `/api/functions/GetEmployeeCertificates`;
            return new Promise(resolve => {
              ESS.network.sendRequest(serviceUrl)
                .then(certs => ESS.signing.createSignature({
                  certificates: certs,
                  document: {
                    binaryDataId: document.BinaryDataId,
                    name: document.Name,
                  },
                  cancelationCallback: params.cancelationCallback,
                }))
                .then(signature => {
                  resolve(JSON.stringify({
                    ...document,
                    Signature: signature,
                    SignatureType: params.SignatureType,
                  }));
                });
            });
          }
        }
      ]]></code>
    </script>
