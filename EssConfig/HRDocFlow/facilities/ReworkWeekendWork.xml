        <property name="workTo" binding="WorkDateTo" type="String" />
        <property name="firstBreakFrom" binding="FirstBreakFrom" type="String" />
        <property name="firstBreakTo" binding="FirstBreakTo" type="String" />
        <property name="secondBreakFrom" binding="SecondBreakFrom" type="String" />
        <property name="secondBreakTo" binding="SecondBreakTo" type="String" />
