        <property name="NextStepIndex">1</property>
        <property name="TargetSystem">HRPro</property>
        <property name="FunctionName">NNOtherProcesses.FillStatementDataForWeekendWork</property>
        <property name="ExecutionMethod">Post</property>
        <property name="docId" binding="DocumentId" type="Int" />
        <property name="docKindGuid" binding="DocKindGuid" type="String" />
        <property name="employeeId" binding="InitiatorId" type="Int" />
        <property name="reasonId" binding="Reason" type="Int" />
        <property name="compensation" binding="Compensation" type="Int" />
        <property name="description" binding="ReasonDescription" type="String" />
