  </facilityFlowScheme>
  <openingEventHandler><![CDATA[
    window.getTime = function (dateTimeValue) {
      var dateTime = new Date(dateTimeValue);
      return dateTime.getHours() * 60 + dateTime.getMinutes();
    }

    window.getDateTime = function (formItemName) {
      var date = functions.getValues().BeginDateWork;
      if (date == null)
        return null;
      var minutes = functions.getValues()[`${formItemName}Time`] ?? 0;
      if (minutes == -1)
        return null;
      var dateTime = new Date(new Date(date).setHours(0, minutes, 0, 0));
      return dateTime;
    }

    window.checkDate = function (formItemName, formItemNameBegin, errorText) {
      var formItemValue = functions.getValues()[`${formItemName}`];
      if (formItemValue != null) {
        var today = new Date().setHours(0, 0, 0, 0);
        var date = window.getDateTime(formItemName);
        var beginDate = window.getDateTime(formItemNameBegin);
        functions.removeError(window[`errorDate${formItemName}`]);
        if ((date.getTime() < today) || (beginDate != null && date.getTime() < beginDate.getTime())) {
          window[`errorDate${formItemName}`] = functions.showError(errorText, undefined, ESS.enums.FormErrorType.UNSPECIFIED, formItemName);
        }
      }
    }

    window.checkEndWorkTime = function () {
      var beginWorkTime = +functions.getValues().BeginDateWorkTime;
      var endWorkTime = +functions.getValues().EndDateWorkTime;
      functions.removeError(window[`errorEndWorkTime`]);
      if (beginWorkTime > endWorkTime) {
        window[`errorEndWorkTime`] = functions.showError(ESS.L('@HRPROSTATEMENTS.FACILITIES_WEEKENDWORK_ENDDATEWORK_ERROR'), undefined, ESS.enums.FormErrorType.UNSPECIFIED, 'EndDateWorkTime');
      }
    }

    window.checkDateRest = function () {
      var dateRest = functions.getValues().DateRest;
      var dateWork = functions.getValues().BeginDateWork;
      functions.removeError(window[`errorDateRest`]);
      functions.removeError(window[`errorDateRestReq`]);
      if (dateRest && dateWork && new Date(dateRest).getTime() != 0 && new Date(dateRest).getTime() <= new Date(dateWork).getTime()) {
        window[`errorDateRest`] = functions.showError(ESS.L('@HRPROSTATEMENTS.FACILITIES_WEEKENDWORK_DATEREST_ERROR'), undefined, ESS.enums.FormErrorType.UNSPECIFIED, 'DateRest');
        window[`errorDateRestReq`] = functions.showError(ESS.L('@HRPROSTATEMENTS.FACILITIES_WEEKENDWORK_DATEREST_ERROR'), undefined, ESS.enums.FormErrorType.UNSPECIFIED, 'DateRestRequired');
      }
    }

    window.checkBreakTime = function (formItemName) {
      functions.removeError(window[`error${formItemName}`]);
      var breakTime = +functions.getValues()[`${formItemName}`];
      if (breakTime == -1)
        return;
      var beginDateWorkTime = +functions.getValues().BeginDateWorkTime;
      var endDateWorkTime = +functions.getValues().EndDateWorkTime;
      if (breakTime < beginDateWorkTime || breakTime > endDateWorkTime)
        window[`error${formItemName}`] = functions.showError(ESS.L('@HRPROSTATEMENTS.FACILITIES_WEEKENDWORK_BREAKTIME_ERROR'), undefined, ESS.enums.FormErrorType.UNSPECIFIED, formItemName);
    }

    var assignmentId = functions.getValues().AssignmentId;
    ESS.network.sendRequest(`/api/functions/GetPostListByPerson`)
    .then(function (employee){
      if (employee.positions.length == 1) {
        functions.setIsItemHidden('PerformerInfo', true);
      }
    });
    ESS.network.sendRequest(`/api/functions/GetStatementDataForReworkWeekendWork?assignmentId=${assignmentId}`)
    .then(function (statementData) {
      var initiatorId = statementData.InitiatorId;
      var workDateFrom = statementData.WorkDateFrom;
      var workDateTo = statementData.WorkDateTo;
      var firstBreakFrom = statementData.FirstBreakFrom;
      var firstBreakTo = statementData.FirstBreakTo;
      var secondBreakFrom = statementData.SecondBreakFrom;
      var secondBreakTo = statementData.SecondBreakTo;
      var restDateFrom = statementData.RestDateFrom;
      var restDateTo = statementData.RestDateTo;

      functions.setValue('InitiatorId', initiatorId);
      functions.setValue('DocumentId', statementData.StatementId);
      functions.setValue('PerformerInfo', statementData.PerformerInfo);
      functions.setValue('AdditionalApprover', statementData.AdditionalApproverId);
      functions.setValue('Reason', statementData.Reason);
      functions.setValue('ReasonDescription', statementData.ReasonDescription);

      functions.setValue('BeginDateWork', workDateFrom);
      functions.setValue('BeginDateWorkTime', `${window.getTime(workDateFrom)}`);
      functions.setValue('EndDateWorkTime', `${window.getTime(workDateTo)}`);

      if (firstBreakFrom) {
        functions.setValue('BeginFirstBreakTime', `${window.getTime(firstBreakFrom)}`);
      }
      if (firstBreakTo) {
        functions.setValue('EndFirstBreakTime', `${window.getTime(firstBreakTo)}`);
      }
      if (secondBreakFrom) {
        functions.setValue('BeginSecondBreakTime', `${window.getTime(secondBreakFrom)}`);
      }
      if (secondBreakTo) {
        functions.setValue('EndSecondBreakTime', `${window.getTime(secondBreakTo)}`);
      }
      if (restDateFrom) {
        functions.setValue('DateRest', restDateFrom);
        functions.setValue('DateRestRequired', restDateFrom);
      }

      var docKindGuid = functions.getValues().DocKindGuid;
      ESS.network.sendRequest(`/api/functions/GetCompensationKindsByDocKind?docKindGuid=${docKindGuid}`)
      .then(function (compensationData) {
        var compensationDataJSON = JSON.stringify(compensationData);
        functions.setValue('CompensationData', compensationDataJSON);
        functions.setDataSource('Compensation', `/api/functions/GetJsonForDataSource?json=${compensationDataJSON}`, statementData.Compensation);
        resolve();
      });
    })
    .catch(function (error) {
      ESS.toasts.showToast(error.message, 'danger', false);
    });
  ]]></openingEventHandler>
  <openedEventHandler><![CDATA[
    window.getDateTimeToString = function (formItemName) {
      var dateTime = window.getDateTime(formItemName);
      if (dateTime == null)
        return '';
      return dateTime.toLocaleString();
    }
  ]]></openedEventHandler>
  <beforeSubmitEventHandler><![CDATA[
    var initiatorId = functions.getValues().InitiatorId;
    var docKindGuid = functions.getValues().DocKindGuid;
    var workDateFrom = window.getDateTimeToString('BeginDateWork');
    var workDateTo = window.getDateTimeToString('EndDateWork');
    var firstBreakFrom = window.getDateTimeToString('BeginFirstBreak');
    var firstBreakTo = window.getDateTimeToString('EndFirstBreak');
    var secondBreakFrom = window.getDateTimeToString('BeginSecondBreak');
    var secondBreakTo = window.getDateTimeToString('EndSecondBreak');
    var restDateFrom = functions.getValues().DateRest;
    var restDateTo = functions.getValues().DateRest;

    functions.setValue('WorkDateFrom', workDateFrom);
    functions.setValue('WorkDateTo', workDateTo);
    functions.setValue('FirstBreakFrom', firstBreakFrom);
    functions.setValue('FirstBreakTo', firstBreakTo);
    functions.setValue('SecondBreakFrom', secondBreakFrom);
    functions.setValue('SecondBreakTo', secondBreakTo);

    ESS.network.sendRequest(`/api/functions/ValidateWeekendWorkStatement?employeeId=${initiatorId}&workFrom=${workDateFrom}&workTo=${workDateTo}&firstBreakFrom=${firstBreakFrom}&firstBreakTo=${firstBreakTo}&secondBreakFrom=${secondBreakFrom}&secondBreakTo=${secondBreakTo}`)
    .then(function (result) {
      if (result && result.length != 0) {
        ESS.toasts.showToast(result, 'danger', false);
        reject();
      }
      else {
        ESS.network.sendRequest(`/api/functions/ValidateWeekendWorkStatementInExternalSystem?DocKindGuid=${docKindGuid}&EmployeeId=${initiatorId}&WorkDateFrom=${workDateFrom}&WorkDateTo=${workDateTo}&RestDateFrom=${restDateFrom}&RestDateTo=${restDateTo}`)
        .then(function (result) {
          if (result && result.length != 0) {
            ESS.toasts.showToast(result, 'danger', false);
            reject();
          }
          else {
            resolve();
          }
        })
        .catch(function (error) {
          ESS.toasts.showToast(error.message, 'danger', false);
          reject();
        });
      }
    })
    .catch(function (error) {
      ESS.toasts.showToast(error.message, 'danger', false);
      reject();
    });
  ]]></beforeSubmitEventHandler>
  <closingEventHandler><![CDATA[]]></closingEventHandler>
