    <facilityFormItem type="FacilityFormParameter">
      <hint />
      <isReadOnly>false</isReadOnly>
      <isHidden>false</isHidden>
      <label>@.FACILITIES_GETLRDPAYMENT_PAYMENTTYPE</label>
      <parameterName>PaymentType</parameterName>
      <valueChangedEventHandler><![CDATA[
        functions.removeError(window[`error${formItem.name}`]);
        var paymentTypeId = formItem.value;
        if (paymentTypeId) {
          var initiatorId = functions.getValues().InitiatorId;
          var childData = JSON.parse(functions.getValues().ChildData);
          ESS.network.sendRequest(`/api/functions/GetPaymentTypeSetting?paymentTypeId=${paymentTypeId}&employeeId=${initiatorId}`)
          .then(function (setting) {
            var isChildSupport = setting.IsChildSupport;
            var fixedAmount = setting.FixedAmount;
            functions.setValue('Instruction', setting.Instruction);
            functions.setValue('MaxAmount', setting.Amount);
            functions.setIsItemDisabled('Amount', fixedAmount);
            functions.setIsItemHidden('Child', !isChildSupport);
            functions.setIsItemHidden('BirthDate', !isChildSupport);
            functions.setIsItemHidden('Consent', !(isChildSupport && setting.IsMale));
            functions.setValue('Child', null);
            functions.setValue('BirthDate', null);
            if (isChildSupport && (!childData || !childData.length)) {
              window[`error${formItem.name}`] = functions.showError(ESS.L('@HRPROSTATEMENTS.FACILITIES_GETLRDPAYMENT_CHILD_NOTFOUND_ERROR'), undefined, ESS.enums.FormErrorType.UNSPECIFIED, formItem.name);
            }
            if (fixedAmount && setting.Amount) {
              functions.setValue('Amount', setting.Amount);
            }
            window.checkAmount();
          });
        }
      ]]></valueChangedEventHandler>
    </facilityFormItem>
