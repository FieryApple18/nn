  <openingEventHandler><![CDATA[
    var assignmentId = functions.getValues().AssignmentId;
    ESS.network.sendRequest(`/api/functions/GetPostListByPerson`)
    .then(function (employee){
      if (employee.positions.length == 1) {
        functions.setIsItemHidden('PerformerInfo', true);
      }
    });
    ESS.network.sendRequest(`/api/functions/GetLrdPaymentDataForRework?assignmentId=${assignmentId}`)
    .then(function (statementData) {
      var initiatorId = statementData.EmployeeId;
      functions.setValue('InitiatorId', initiatorId);
      functions.setValue('PerformerInfo', statementData.PerformerInfo);
      functions.setValue('StatementId', statementData.StatementId);
      functions.setValue('Reason', statementData.Reason);
      functions.setValue('Field_Причина', statementData.Reason);
      
      ESS.network.sendRequest(`/api/functions/GetLrdPaymentStatementTemplateId?employeeId=${initiatorId}`)
      .then(function (VacationStatementData) {
        if (VacationStatementData.Error.length == 0) {
          functions.setValue('TemplateId', VacationStatementData.TemplateId);
          functions.setValue('DocumentKindId', VacationStatementData.DocumentKindId);

          ESS.network.sendRequest(`/api/functions/GetChildrenByEmployeeId?employeeId=${initiatorId}`)
          .then(function (childData) {
            var childDataString = JSON.stringify(childData);
            functions.setValue('ChildData', childDataString);
            functions.setDataSource('PaymentType', `/api/functions/GetPaymentTypesByEmployeId?employeeId=${initiatorId}`, statementData.PaymentTypeId);
            functions.setValue('Amount', statementData.Amount);
            var child = childData.find(item => item.Name == statementData.ChildFIO);
            functions.setDataSource('Child', `/api/functions/GetJsonForDataSource?json=${childDataString}`, child?.Name);
            resolve();
          });
        }
        else {
          ESS.dialogs.showMessageBox(ESS.L('@HRPROVACATIONS.ERROR_COMMON'), VacationStatementData.Error);
          reject();
        }
      });
    });
  ]]></openingEventHandler>
  <openedEventHandler><![CDATA[
    window.checkAmount = function () {
      var amountValue = functions.getValues().Amount;
      var maxAmountValue = functions.getValues().MaxAmount;
      functions.removeError(window.amountError);
      if (!amountValue || !maxAmountValue)
        return;
      var amount = parseFloat(amountValue.replace(",", "."));
      var maxAmount = parseFloat(maxAmountValue.replace(",", "."));
      if (amount > maxAmount) {
        window.amountError = functions.showError(ESS.formatString(ESS.L('@HRPROSTATEMENTS.FACILITIES_GETLRDPAYMENT_AMOUNT_ERROR'), maxAmountValue), undefined, ESS.enums.FormErrorType.UNSPECIFIED, 'Amount');
      }
    }
  ]]></openedEventHandler>
  <beforeSubmitEventHandler><![CDATA[
    var initiatorId = functions.getValues().InitiatorId;
    var paymentTypeId = functions.getValues().PaymentType;
    var child = functions.getValues().Child;
    var birthDate = functions.getValues().BirthDate;

    ESS.network.sendRequest(`/api/functions/CheckLrdPaymentInExternalSystem?EmployeeId=${initiatorId}&PaymentTypeId=${paymentTypeId}&ChildName=${child}&BirthDate=${birthDate}`)
    .then(function (result) {
      if (result && result.length != 0) {
        ESS.toasts.showToast(result, 'danger', false);
        reject();
      }
      else {
        resolve();
      }
    })
    .catch(function (error) {
      ESS.toasts.showToast(error.message, 'danger', false);
      reject();
    });
  ]]></beforeSubmitEventHandler>
  <closingEventHandler><![CDATA[]]></closingEventHandler>
  <closedEventHandler><![CDATA[
    if (sender.performingAction === 'SUBMIT_FACILITY_PARAMETERS') 
    {
      ESS.closeElement(sender.parent); 
      ESS.widgets.updateWidgets();
    }
    ]]></closedEventHandler>
  <successMessage>@HRPROVACATIONS.FACILITIES_GETVACATION_SUCCESSMESSAGE</successMessage>
</facility>