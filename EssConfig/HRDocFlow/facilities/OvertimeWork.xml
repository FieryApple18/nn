      <label>@.FACILITIES_WEEKENDWORK_COMPENSATION</label>
      <parameterName>Compensation</parameterName>
      <valueChangedEventHandler><![CDATA[
        var compensationData = JSON.parse(functions.getValues().CompensationData);
        var compensation = compensationData.find(item => item.Id == formItem.value);
        var isRest = compensation.NeedRestDate;
        var IsRestRequired = compensation.IsRestDateRequired;
        functions.setIsItemHidden('DateRest', !isRest || IsRestRequired);
        functions.setIsItemHidden('DateRestRequired', !isRest || !IsRestRequired);
        functions.setIsItemHidden('BeginDateRestTime', !isRest);
        functions.setIsItemHidden('EndDateRestTime', !isRest);
        if (!isRest) {
          if (functions.getValues().DateRest) {
            functions.removeError(window[`errorDateRest`]);
            functions.removeError(window[`errorDateRestReq`]);
            functions.setValue('DateRest', null);
            functions.setValue('DateRestRequired', null);
          }
          functions.removeError(window[`errorEndRestTime`]);
          functions.setValue('BeginDateRestTime', -1);
          functions.setValue('EndDateRestTime', -1);
        }
      ]]></valueChangedEventHandler>
