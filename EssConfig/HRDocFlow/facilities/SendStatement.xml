        <openingEventHandler><![CDATA[
            ESS.network.sendRequest(`/api/functions/GetPostListByPerson`)
            .then(function (employee){
              ESS.network.sendRequest(`/api/functions/GetEmployeeCertificates`)
              .then(function (certs){
                if (certs.length != 0)
                {
                  if (employee.positions.length == 0)
                  {
                    ESS.network.sendRequest(`/api/functions/GetInitiatorId`)
                    .then(function (initiatorId){
                        functions.setValue('Initiator', initiatorId);
                    })
                    .catch(function (error) {
                      ESS.toasts.showToast(error.message, 'danger', false);
                      reject();
                      });
                    resolve();
                  }
                  if (employee.positions.length == 1)
                  {
                    functions.removeError(window.errorInitiator);
                    ESS.network.sendRequest(`/api/functions/GetInitiatorId`)
                    .then(function (initiatorId){
                      ESS.network.sendRequest(`/api/functions/CheckEmployeeConsentSigned`)
                      .then(function (isConsentSigned) {
                        if (isConsentSigned != true) {
                          ESS.dialogs.showMessageBox(ESS.L('@HRPROSTATEMENTS.ERROR_COMMON'), ESS.L('@HRPROSTATEMENTS.FACILITIES_SENDSTATEMENT_CONSENT_ERROR'));
                          reject();
                        } else {
                          resolve();
                        }
                      })
                      .catch(function (error) {
                        ESS.toasts.showToast(error.message, 'danger', false);
                        reject();
                      });
                    })
                    .catch(function (error) {
                      ESS.toasts.showToast(error.message, 'danger', false);
                      reject();
                    });
                  } else {
                    resolve();
                  }
                }
                else {
                  ESS.dialogs.showMessageBox(ESS.L('@HRPROSTATEMENTS.ERROR_COMMON'), ESS.L('@HRPROSTATEMENTS.FACILITIES_SENDSTATEMENT_NO_CERTIFICATES_ERROR'));
                  reject();
                }
              })
              .catch(function (error) {
                ESS.toasts.showToast(error.message, 'danger', false);
                reject();
              });
            })
            .catch(function (error) {
              ESS.toasts.showToast(error.message, 'danger', false);
              reject();
            });
          ]]>
        </openingEventHandler>
        <openedEventHandler><![CDATA[
          var initiatorId = functions.getValues().Initiator;
          if (initiatorId != null) {
            ESS.network.sendRequest(`/api/functions/CheckEmployeeConsentSigned?employeeId=${initiatorId}`)
            .then(function (isConsentSigned) {
              if (isConsentSigned != true) {
                window.errorInitiator = functions.showError(ESS.L('@HRPROSTATEMENTS.FACILITIES_SENDSTATEMENT_CONSENT_ERROR'));
              }
            })
          }
        ]]></openedEventHandler>
