            </flowStep>
            <flowStep index="4" name="ExecuteFunction" title="Запуск прикладной функции GetEmployeeByUniqueId" type="ExecuteFunctionStep">
              <property name="NextStepIndex">5</property>
              <property name="TargetSystem">HRPro</property>
              <property name="FunctionName">HRDocFlow.GetDocumentFieldValue</property>
              <property name="ExecutionMethod">GET</property>
              <property name="employeeId" binding="Initiator" type="Int32" />
              <property name="fieldName">DEPARTMENT_NAME</property>
              <property name="Result" binding="Field_Наименование отдела (и.п.),Mode=PropertyToParameter"/>
            </flowStep>
            <flowStep index="5" name="ExecuteFunction" title="Запуск прикладной функции GetDocumentFieldValue" type="ExecuteFunctionStep">
                <property name="NextStepIndex">6</property>
                <property name="TargetSystem">HRPro</property>
                <property name="FunctionName">HRDocFlow.GetDocumentFieldValue</property>
                <property name="ExecutionMethod">GET</property>
                <property name="employeeId" binding="Initiator" type="Int32" />
                <property name="fieldName">CURRENT_USER_FULLNAME_GENITIVE</property>
                <property name="Result" binding="Field_ФИО сотрудника (р.п.),Mode=PropertyToParameter"/>
            </flowStep>
            <flowStep index="6" name="ApplicationGeneration" title="Сгенерировать заявление" type="DocumentGenerationStep">
                <property name="NextStepIndex">7</property>
                <property name="TargetSystem">HRPro</property>
                <property name="DocumentId" type="Int32" binding="TemplateId" />
                <property name="DocumentFormat">pdfa</property>
                <property name="DocumentGroup">IElectronicDocuments</property>
                <property name="DocumentFields" binding="Field_*" type="KeyValue[]" />
                <property name="DocumentName" binding="DocumentNameParam,Field_И.О. Фамилия сотрудника,#TODAY,Format={0} {1} от {2}" />
                <property name="GenerationValue" binding="StoredDocumentParam,Mode=PropertyToParameter" type="StoredDocument" />
            </flowStep>
            <actionStep index="7" name="CreateSignatureAction" title="Добавить подпись к документу из СХ">
                <property name="NextStepIndex">8</property>
                <property name="ActionName">HrProStatements.createSignature</property>
                <property name="SigningDocument" binding="StoredDocumentParam" type="StoredDocument" />
                <property name="SignatureType">Approval</property>
                <property name="Result" binding="StoredDocumentParam,Mode=PropertyToParameter" />
                <property name="employeeId" binding="Initiator" type="Int32" />
            </actionStep>
            <flowStep index="8" name="ImportDocumentsRX" title="Импортировать сгенерированный документ в RX" type="ImportDocumentGroupStep">
                <property name="NextStepIndex">9</property>
                <property name="TargetSystem">HRPro</property>
                <property name="ImportingDocuments" binding="StoredDocument*" type="StoredDocument[]" />
                <property name="DocumentGroup">IHRDocFlowStatementDocuments</property>
                <property name="Author" binding="Initiator,Format={{'Id':{0}}}"/>
                <property name="Actor" binding="Initiator"/>
                <property name="DocumentKind" binding="DocumentKind,Format={{'Id':{0}}}" />
                <property name="ImportedDocuments" binding="ImportedDocumentLinks,Mode=PropertyToParameter" />
            </flowStep>
            <flowStep index="9" name="ImportApplicationRX" title="Импортировать приложение в RX" type="ImportDocumentGroupStep">
                <property name="NextStepIndex">10</property>
                <property name="TargetSystem">EssBase</property>
                <property name="ImportingDocuments" binding="Application*" type="StoredDocument[]" />
                <property name="DocumentGroup">ISimpleDocuments</property>
                <property name="Author" binding="Initiator,Format={{'Id':{0}}}"/>
                <property name="ImportedDocuments" binding="ImportedApplicationLinks,Mode=PropertyToParameter" />
            </flowStep>
            <flowStep index="10" title="Сформировать группу вложений" type="CreateAttachmentGroupStep">
                <property name="NextStepIndex">11</property>
                <property name="GroupName">DocumentGroup</property>
                <property name="Documents" binding="ImportedDocumentLinks" type="DocumentLink[]" />
                <property name="Result" binding="TaskAttachments,Mode=PropertyToParameter"></property>
            </flowStep>
            <flowStep index="11" title="Сформировать группу вложений для приложений" type="CreateAttachmentGroupStep">
                <property name="NextStepIndex">12</property>
                <property name="GroupName">OtherGroup</property>
                <property name="Documents" binding="ImportedApplicationLinks" type="DocumentLink[]" />
                <property name="Result" binding="TaskAttachmentsApplications,Mode=PropertyToParameter"></property>
            </flowStep>
            <flowStep index="12" name="StartStatementTask" title="Запустить задачу на согласование заявления" type="StartWorkProcessStep">
                <property name="ProcessName">IHRDocFlowStatementTasks</property>
                <property name="TargetSystem">HRPro</property>
                <property name="NextStepIndex">-1</property>
                <property name="Author" binding="Initiator,Format={{'Id':{0}}}"/>
                <property name="StartedBy" binding="Initiator,Format={{'Id':{0}}}"/>
                <property name="Subject">@HRPROSTATEMENTS.FACILITIES_STATEMENTUPDATEPERSONALDATA_FLOWSTEP_STARTSTATEMENTTASK_SUBJECT</property>
                <property name="NeedsReview">False</property>
                <property name="Importance">Normal</property>
                <property name="Attachments" binding="TaskAttachments*" type="Attachment[]" />
                <property name="Id" binding="TaskId,Mode=PropertyToParameter" type="Int32" />
            </flowStep>
        </flowSteps>
    </facilityFlowScheme>
    <openingEventHandler><![CDATA[
        ESS.network.sendRequest(`/api/functions/GetPostListByPerson`)
        .then(function (employee){
            if (employee.positions.length == 0)
            {
                ESS.network.sendRequest(`/api/functions/GetInitiatorId`)
                .then(function (initiatorId){
                    functions.setValue('Initiator', initiatorId);
                })
                .catch(function (error) {
                    ESS.toasts.showToast(error.message, 'danger', false);
                    reject();
                });
            }
            resolve();
        })
        .catch(function (error) {
            ESS.toasts.showToast(error.message, 'danger', false);
            reject();
        });
    ]]>
    </openingEventHandler>
