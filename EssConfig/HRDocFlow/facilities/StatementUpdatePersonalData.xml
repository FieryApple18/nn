    <facilityFlowScheme firstStepIndex="0" lastStepIndex="-1">
        <flowSteps>
            <flowStep index="0" name="ExecuteFunction" title="Запуск прикладной функции GetDocumentFieldValue" type="ExecuteFunctionStep">
