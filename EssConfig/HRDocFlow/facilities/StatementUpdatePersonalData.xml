                var initiatorId = formItem.value || '$(CurrentUser.DirectumRX.ActorId)'
                ESS.network.sendRequest('/api/functions/HRPro/HRDocFlow.GetJSONForStatementsWidget?userId=' + initiatorId, { method: 'GET' })
                .then(function (documentStatementData) {
                    for (var templ in documentStatementData)
                    {
                        if (documentStatementData[templ].title == ESS.L('@HRPROSTATEMENTS.FACILITIES_STATEMENTUPDATEPERSONALDATA_DOCUMENTNAMEPARAM'))
                        {
                            var templateId = JSON.parse(documentStatementData[templ].parameters[0].defaultValue);
                            var docKindId = JSON.parse(documentStatementData[templ].parameters[1].defaultValue);
                            functions.setValue('TemplateId', templateId);
                            functions.setValue('DocumentKind', docKindId);
                            break;
                        }
                    }
                })
                .catch(function (error) {
                    ESS.toasts.showToast(error.message, 'danger', false);
                    reject();
                });
            ]]>
