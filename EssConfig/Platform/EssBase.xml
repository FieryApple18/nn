<?xml version="1.0" encoding="utf-8"?>
<solution name="EssBase">
  <dataSchemeVersion>1.4.63</dataSchemeVersion>
  <title>Базовое прикладное решение</title>
  <startPage>welcomePage</startPage>
  <version>2.7.0.0</version>
  <widgets>
    <widget name="requiresActions" type="workItemList">
      <icon>check-mark</icon>
      <title>@.FACILITYGROUPS_WIDGET_SIGNDOCUMENTS</title>
      <dataSourceUrl>/api/activeWorks?orderBy=created desc</dataSourceUrl>
      <properties>
        <defaultObjectCard>Default</defaultObjectCard>
        <showTitleCounter>True</showTitleCounter>
        <workItemSubtitle>@.FACILITYGROUPS_WIDGET_ACTIVEWORKS_SUBTITLE</workItemSubtitle>
      </properties>
    </widget>
	
    <widget name="requiresActionsCustom" type="workItemList">
      <icon>check-mark</icon>
      <title>@.FACILITYGROUPS_WIDGET_SIGNDOCUMENTS</title>
      <dataSourceUrl>/api/activeWorksCustom</dataSourceUrl>
      <properties>
        <defaultObjectCard>Default</defaultObjectCard>
        <showTitleCounter>True</showTitleCounter>
        <workItemSubtitle>@.FACILITYGROUPS_WIDGET_ACTIVEWORKS_SUBTITLE</workItemSubtitle>
      </properties>
    </widget>

    <widget name="history" type="workItemList">
      <title>@.FACILITYGROUPS_WIDGET_HISTORY_TITLE</title>
      <dataSourceUrl>/api/completedWorks?orderBy=finished desc</dataSourceUrl>
      <properties>
        <defaultObjectCard />
        <showTitleCounter>False</showTitleCounter>
        <workItemSubtitle>{{result}} {{#localizeDate}}{{finished}}{{/localizeDate}}</workItemSubtitle>
      </properties>
    </widget>
	
    <widget name="historyCustom" type="workItemList">
      <title>@.FACILITYGROUPS_WIDGET_HISTORY_TITLE</title>
      <dataSourceUrl>/api/completedWorksCustom</dataSourceUrl>
      <properties>
        <defaultObjectCard />
        <showTitleCounter>False</showTitleCounter>
        <workItemSubtitle>@.FACILITYGROUPS_WIDGET_HISTORY_SUBTITLE</workItemSubtitle>
      </properties>
    </widget>
  </widgets>

  <facilityGroups>
    <facilityGroup name="Home">
      <icon>home</icon>
      <title>@.FACILITYGROUPS_TITLE_HOME</title>
      <priority>1000</priority>
      <isVisible>true</isVisible>
      <collectAllNotifications>false</collectAllNotifications>
      <views>
        <view device="Web" container="StackPanel" name="homeWeb">
          <orientation>Vertical</orientation>
          <bounds>
            <bound widgetName="requiresActionsCustom" />
          </bounds>
        </view>
        <view device="Mobile" container="StackPanel" name="homeMobile">
          <orientation>Vertical</orientation>
          <bounds>
            <bound widgetName="requiresActionsCustom" />
          </bounds>
        </view>
      </views>
    </facilityGroup>
	
    <facilityGroup name="History">
      <icon>history</icon>
      <title>@.FACILITYGROUPS_HISTORY</title>
      <priority>999</priority>
      <isVisible>false</isVisible>
      <collectAllNotifications>false</collectAllNotifications>
      <views>
        <view name="homeWeb" device="Web" container="StackPanel">
          <orientation>Vertical</orientation>
          <bounds>
            <bound widgetName="historyCustom" />
          </bounds>
        </view>
        <view name="homeMobile" device="Mobile" container="StackPanel">
          <orientation>Vertical</orientation>
          <bounds>
            <bound widgetName="historyCustom" />
          </bounds>
        </view>
      </views>
    </facilityGroup>

