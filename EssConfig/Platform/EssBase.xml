        <property name="deadline" caption="Срок" type="DateTime" />
        <property name="finished" caption="Дата завершения" type="DateTime" />
        <property name="created" caption="Дата создания" type="DateTime" />
        <property name="hasAttachments" caption="Признак наличия вложений" type="Boolean" />
        <property name="id" caption="Идентификатор" type="String" />
        <property name="isExpired" caption="Признак просроченности" type="Boolean" />
        <property name="isRead" caption="Признак прочитанности" type="Boolean" />
        <property name="name" caption="Имя" type="String" />
        <property name="processName" caption="Имя процесса" type="String" />
        <property name="result" caption="Результат выполнения" type="String" />
        <property name="status" caption="Состояние" type="String" />
        <property name="system" caption="Имя системы" type="String" />
        <property name="title" caption="Заголовок" type="String" />
        <property name="icon" caption="Иконка" type="String" />
        <property name="defaultActionName" caption="Имя действия" type="String" />
        <property name="defaultActionCaption" caption="Заголовок действия" type="String" />
        <property name="defaultActionIcon" caption="Иконка действия" type="String" />
      </properties>
    </projection>
	
