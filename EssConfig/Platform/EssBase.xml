  <pages>
    <page name="welcomePage" title="@.PAGE_INFO">
      <content />
      <pageLoadedHandler>
        <![CDATA[
          ESS.overlay.showOverlay(123, ESS.L('@ESSBASE.PAGE_INFO'));

          ESS.network.sendRequest("/api/functions/ChangePersonalAccountStatusToInviteAccepted",
            { method: "POST", body: JSON.stringify({}) })
            .then(function () {
              ESS.overlay.hideOverlay(123);
              resolve();
            })
            .catch(function (error) {
              ESS.overlay.hideOverlay(123);
              reject({message: ESS.L('@ESSBASE.PAGE_ERROR')});
            });
        ]]>
      </pageLoadedHandler>
    </page>
  </pages>

  <valueConverters>
    <valueConverter name="toLongMonthYear" runat="Client">
      <function>
        <![CDATA[
          return converters.toLongMonthYear(value);
        ]]>
      </function>
    </valueConverter>

    <valueConverter name="simplifyDate" runat="Client">
      <function>
        <![CDATA[
          if (!value) {
            return '';
          }
          const date = new Date(value);
          const options = date.getHours() || date.getMinutes() ? { hour: '2-digit', minute: '2-digit' } : {};
          return date.toLocaleDateString(language, options);
        ]]>
      </function>
    </valueConverter>

    <valueConverter name="getDeadline" runat="Client">
      <function>
        <![CDATA[
          const { result, deadline, isExpired } = parameter || {};
          if (!result && deadline) {
            const date = converters.EssBase.simplifyDate(deadline);
            const style = isExpired ? ' style="color: rgb(255,95,95);"' : '';
            return `<div${style}>${date}</div>`;
          }
          return '';
        ]]>
      </function>
    </valueConverter>

    <valueConverter name="toTaskScheme" runat="Client">
      <function>
        <![CDATA[
          const { status } = parameter || {};
          const endedStatuses = [
            ESS.enums.WorkProcessStatus.ABORTED,
            ESS.enums.WorkProcessStatus.COMPLETED,
          ];
          if (endedStatuses.includes(status)) {
            return '';
          }
          return `
            <component
              name="EssBase_Component"
              public-name="ESS_RemoteComponent"
              module-name="loaders"
              loader-name="task-scheme"

              get-task-scheme-function-name_comment="
                Атрибут для указания имени функции получения маршрута.
                В качестве дефолтного значения используется 'GetTaskScheme'."
              get-task-scheme-function-name=""

              task-id_comment="
                Атрибут для указания идентификатора задачи.
                Является не обязательным, если в качестве родительского элемента выступает карточка.
                В качестве дефолтного значения для карточки используется значение 'controlInfo.data.id'."
              task-id=""
            />
          `;
        ]]>
      </function>
    </valueConverter>
  </valueConverters>
  
  <functions>
    <function name="GetHistoryAssignmentsForWorkItemList" type="Target" methods="GET">
      <parameters>
        <parameter name="personId" type="Integer" scope="Server">
          <defaultValue>$(CurrentUser.DirectumRX.PersonId)</defaultValue>
        </parameter>
      </parameters>
      <result type="Object" />
      <target system="EssBase" function="NNOtherProcesses.GetHistoryAssignmentsForWorkItemList" method="GET" />
    </function>
  
    <function name="GetAssignmentsForWorkItemList" type="Target" methods="GET">
      <parameters>
        <parameter name="personId" type="Integer" scope="Server">
          <defaultValue>$(CurrentUser.DirectumRX.PersonId)</defaultValue>
        </parameter>
      </parameters>
      <result type="Object" />
      <target system="EssBase" function="NNOtherProcesses.GetAssignmentsForWorkItemList" method="GET" />
    </function>

    <function name="EssBase_GetPositionListByPerson" type="Target" methods="GET">
      <parameters>
        <parameter name="personId" type="Integer" scope="Server">
          <defaultValue>$(CurrentUser.DirectumRX.PersonId)</defaultValue>
        </parameter>
      </parameters>
      <result type="Object" />
      <target system="EssBase" function="EssPlatform.GetPostListByPerson" method="GET" />
    </function>

    <function name="ChangePersonalAccountStatusToInviteAccepted" type="Target" methods="POST">
      <parameters>
        <parameter name="employeeId" type="Integer" scope="Server">
          <defaultValue>$(CurrentUser.DirectumRX.ActorId)</defaultValue>
        </parameter>
      </parameters>
      <target system="EssBase" function="EssPlatform.ChangePersonalAccountStatusToInviteAccepted" method="POST" />
    </function>

    <function name="GetTaskScheme" type="Target" methods="GET">
      <parameters>
        <parameter name="taskId" type="Integer" scope="Client" />
      </parameters>
      <result type="Object" isArray="true" />
      <target system="EssBase" function="EssPlatform.GetTaskScheme" method="GET" />
    </function>
  </functions>
  
  <localizedStringValues>
    <localizedStringValue code="FACILITYGROUPS_WIDGET_HISTORY_SUBTITLE" language="RU" useat="server">
    <![CDATA[
      {{#finished}}
        {{#result}} 
          {{result}} 
          {{#bySubstitution}} за {{assignee}} {{/bySubstitution}} 
        {{/result}} 
        {{#localizeDate}}{{finished}}{{/localizeDate}}
