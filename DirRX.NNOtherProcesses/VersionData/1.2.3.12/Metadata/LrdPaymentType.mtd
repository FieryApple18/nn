  "PublicConstants": [
    {
      "Name": "ChildBirth",
      "ParentClasses": [
        "LrdPaymentType",
        "DefaultNames"
      ],
      "TypeName": "System.String",
      "Value": "\"Материальная помощь на рождение ребенка, а также усыновление детей-сирот и детей, оставшихся без попечения родителей\""
    },
    {
      "Name": "DisabledChild",
      "ParentClasses": [
        "LrdPaymentType",
        "DefaultNames"
      ],
      "TypeName": "System.String",
      "Value": "\"Материальная помощь работнику, имеющему ребенка-инвалида в возрасте до 18 лет\""
    },
    {
      "Name": "DisabledEmployee",
      "ParentClasses": [
        "LrdPaymentType",
        "DefaultNames"
      ],
      "TypeName": "System.String",
      "Value": "\"Материальная помощь работнику-инвалиду\""
    },
    {
      "Name": "Emergency",
      "ParentClasses": [
        "LrdPaymentType",
        "DefaultNames"
      ],
      "TypeName": "System.String",
      "Value": "\"Материальная помощь работнику при материальном ущербе в связи с экстремальной ситуацией (стихийное бедствие, пожар, авария, кража и т.п.) \""
    },
    {
      "Name": "FamilyMemberDeath",
      "ParentClasses": [
        "LrdPaymentType",
        "DefaultNames"
      ],
      "TypeName": "System.String",
      "Value": "\"Материальная помощь работнику в связи со смертью члена семьи\""
    },
    {
      "Name": "LifeOneTimePayment",
      "ParentClasses": [
        "LrdPaymentType",
        "DefaultNames"
      ],
      "TypeName": "System.String",
      "Value": "\"Единовременная выплата в связи с трудной жизненной ситуацией\""
    },
    {
      "Name": "Mutilation",
      "ParentClasses": [
        "LrdPaymentType",
        "DefaultNames"
      ],
      "TypeName": "System.String",
      "Value": "\"Материальная помощь (ежемесячная и единовременная) работникам, получившим увечье\""
    },
    {
      "Name": "Other",
      "ParentClasses": [
        "LrdPaymentType",
        "DefaultNames"
      ],
      "TypeName": "System.String",
      "Value": "\"Материальная помощь в исключительных случаях\""
    },
    {
      "Name": "Retirement",
      "ParentClasses": [
        "LrdPaymentType",
        "DefaultNames"
      ],
      "TypeName": "System.String",
      "Value": "\"Единовременная материальная помощь по уходу на пенсию\""
    }
  ],
